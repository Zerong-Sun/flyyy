# Copy to config.env and source before running scripts:
#   source config.env

# Project root (folder that contains assets/ or your game code)
export ART_GEN_ROOT="/path/to/your-project"

# Where .webp files are written (default: $ART_GEN_ROOT/assets/art)
# export ART_GEN_DIR="$ART_GEN_ROOT/assets/art"

# Where ART_PROMPTS*.md live (default: same as ART_GEN_DIR)
# export ART_GEN_PROMPTS_DIR="$ART_GEN_ROOT/assets/art"

# Optional: audit.py + strip_checker.py for postprocess_art.py
# export ART_GEN_TOOLS_DIR="/path/to/tools/art"

# Chrome debug profile (optional)
# export CHROME_DEBUG_PROFILE="$HOME/.cache/my-project-chrome-debug"
